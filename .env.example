# Copier ce fichier en `.env` (non versionné) pour configurer HeroCraft localement.
# Les variables déjà définies dans l'environnement restent prioritaires.

# Écran où s'ouvre la fenêtre : nom Windows (DISPLAY1, DISPLAY2, ...) ou nom vu par winit.
# Vide ou absent : écran choisi par le système.
# HEROCRAFT_MONITOR=DISPLAY3

# Partie en ligne : adresse du serveur dédié (port 7777 si absent) et nom du joueur.
# Vide ou absent : partie en solo. `--connect ADRESSE`, `--name NOM` et `--solo` en ligne de
# commande l'emportent.
# HEROCRAFT_SERVER=127.0.0.1:7777
# HEROCRAFT_PSEUDO=Mat

# Graine de la planète solo, pour retrouver un monde précis. Vide ou absent : graine aléatoire à
# chaque lancement. `--seed GRAINE` en ligne de commande l'emporte.
# HEROCRAFT_SEED=1234567890
