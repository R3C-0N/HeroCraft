# Copier ce fichier en `.env` (non versionné) pour configurer HeroCraft localement.
# Les variables déjà définies dans l'environnement restent prioritaires.

# Écran où s'ouvre la fenêtre : nom Windows (DISPLAY1, DISPLAY2, ...) ou nom vu par winit.
# Vide ou absent : écran choisi par le système.
# HEROCRAFT_MONITOR=DISPLAY3
